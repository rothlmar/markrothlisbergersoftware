{
  "name": "markrothlisbergersoftware",
  "version": "1.0.0",
  "private": true,
  "description": "Personal freelance site for Mark Rothlisberger (Firebase Hosting + Tailwind CSS).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
