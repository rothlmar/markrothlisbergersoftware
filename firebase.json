{
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build:css"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
